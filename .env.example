# Copy to .env only when you want a local default provider key.
# The Streamlit form uses a run-local override and never persists it.
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Optional provider model overrides.
OPENAI_MODEL=gpt-5.4-mini
NVIDIA_MODEL=openai/gpt-oss-120b

# Optional validated runtime limits.
# SAST_BATCH_MAX_ITEMS=8
# SAST_BATCH_MAX_CHARS=24000
# SAST_UPLOAD_MAX_MIB=25
